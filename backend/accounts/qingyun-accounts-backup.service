[Unit]
Description=Private backup of Qingyun player accounts
After=qingyun-accounts.service

[Service]
Type=oneshot
User=qingyunplayer
Group=qingyunplayer
ExecStart=/usr/bin/python3 /opt/qingyun-accounts/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/qingyun-accounts
MemoryMax=96M
CPUQuota=25%
